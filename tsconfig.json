{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // supabase/ holds the Deno Edge Functions and SQL migrations, which
  // moved here so the product lives in one repository. They are NOT part
  // of the Next.js program: Deno resolves imports with explicit .ts
  // extensions and provides its own globals, so type-checking them with
  // the app's config fails the build. They deploy via the Supabase CLI,
  // which type-checks them itself.
  "exclude": ["node_modules", "supabase"]
}
